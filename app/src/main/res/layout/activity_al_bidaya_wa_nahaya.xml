<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context="com.example.books.AlBidayaWaNahaya">

    <LinearLayout
        android:id="@+id/book_dashboard_layout"
        android:layout_width="match_parent"
        android:background="@drawable/book_board"
        android:layout_height="150dp"
        android:orientation="horizontal"
        android:gravity="center">

        <TextView
            android:id="@+id/textView2"
            android:layout_width="wrap_content"
            android:textColor="#FFFDFC"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:text="@string/albidaya_wan_nahaya"
            android:textSize="35sp" />
    </LinearLayout>
    <ScrollView
        android:layout_width="match_parent"
        android:verticalScrollbarPosition="right"
        android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/Chapters"
        android:layout_width="match_parent"
        android:gravity="center_horizontal"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/first_chap"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:layout_marginBottom="10dp"
            android:layout_marginHorizontal="15dp"
            android:background="@drawable/book_chap_button"
            android:clickable="true"
            android:focusable="true"
            android:padding="12dp">

            <TextView
                android:id="@+id/chap_Number1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="14dp"
                android:text="1."
                android:textColor="#B0006E"
                android:textSize="25sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/chapEnglishName1"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.107" />

            <TextView
                android:id="@+id/arabicName1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:gravity="end"
                android:text="chap"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/chapEnglishName1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="146dp"
                android:layout_marginBottom="2dp"
                android:text="Chapter 1"
                android:textSize="25sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toTopOf="@+id/chapDetails1"
                app:layout_constraintEnd_toStartOf="@+id/arabicName1"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/chapDetails1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/medinan_verses_200"
                android:textColor="#666666"
                android:textSize="16sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.209"
                app:layout_constraintStart_toStartOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

