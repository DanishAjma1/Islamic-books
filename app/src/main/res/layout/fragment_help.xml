<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="com.example.books.HelpFragment"
    tools:theme="@style/Theme.MyMobileApp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="5dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">
            <LinearLayout
                android:orientation="vertical"
                android:layout_marginHorizontal="8dp"
                android:layout_width="match_parent"
                android:layout_marginVertical="20dp"
                android:layout_height="wrap_content">

                <TextView
                    android:text="HELP"
                    android:textSize="40sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_marginTop="10dp"
                    android:padding="20dp"
                    android:textColor="@color/off_white"
                    android:background="@drawable/books_dashboard"
                    android:textAllCaps="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp" />

                <TextView
                    android:text="Welcome to the Islamic Books App!"
                    android:textSize="25sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    android:text="This app provides a collection of authentic Islamic books in Urdu and English. You can read books about Hadith, Tafseer, Seerat-un-Nabi (SAW), Fiqh, and other Islamic knowledge."
                    android:textSize="20sp"
                    android:textStyle="italic"
                    android:layout_marginBottom="12dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    android:text="Navigation Guide:"
                    android:textSize="20sp"
                    android:textStyle="bold|italic"
                    android:layout_marginBottom="12dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    android:text="• Dashboard: Browse the latest books,which are trending for knowledge about islam.\n• All Books: View the full library using image-based buttons.\n• Book Reader: Tap on a book to start reading.\n• Help: Find information and contact details.\n• Profile: View and edit your profile details.\n• Support: Learn how you can contribute."
                    android:textSize="20sp"
                    android:layout_marginBottom="12dp"
                    android:textStyle="italic"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    android:text="For any help or suggestions, feel free to contact us:"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginVertical="10dp"
                >
                <TextView
                    android:text="📧 Email: danishajmalbutt@gmail.com\n📞 Phone: +92 318 7325159\n🌐 Website: www.islamicbooks.org"
                    android:textSize="20sp"
                    android:gravity="center"
                    android:padding="10dp"
                    android:textColor="@color/off_white"
                    android:background="@drawable/page_bottom_design"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

</FrameLayout>