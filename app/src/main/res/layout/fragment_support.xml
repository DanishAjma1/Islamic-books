<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/fragment_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="com.example.books.SupportFragment"
    tools:theme="@style/Theme.MyMobileApp">

    <ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="3dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:orientation="vertical"
            android:padding="10dp"
            android:layout_marginVertical="20dp"
            android:layout_height="match_parent">

            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:padding="0dp"
                android:layout_marginVertical="10dp"
                android:layout_height="wrap_content">

                <TextView
                    android:text="SUPPORT"
                    android:textSize="35sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:textColor="@color/off_white"
                    android:background="@drawable/books_dashboard"
                    android:padding="20dp"
                    android:textAllCaps="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp" />

                <TextView
                    android:text="Support the Islamic Books App"
                    android:textSize="25sp"
                    android:textStyle="bold"
                    android:paddingHorizontal="5dp"
                    android:layout_marginBottom="12dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    android:text="This app is developed to promote Islamic knowledge and make authentic books easily accessible. We welcome your support in any of the following forms:"
                    android:textSize="20sp"
                    android:layout_marginBottom="12dp"
                    android:textStyle="italic"
                    android:paddingHorizontal="5dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    android:text="1. Wealth Support:"
                    android:textSize="20sp"
                    android:textStyle="bold|italic"
                    android:layout_marginBottom="12dp"
                    android:paddingHorizontal="5dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
                <TextView
                    android:text="Contribute financially to help us maintain servers, add more books, and improve app features. Even small donations can make a big difference."
                    android:textSize="20sp"
                    android:textStyle="italic"
                    android:layout_marginBottom="12dp"
                    android:paddingHorizontal="5dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
                <TextView
                    android:text="2. Knowledge Support:"
                    android:textSize="20sp"
                    android:textStyle="bold|italic"
                    android:paddingHorizontal="5dp"
                    android:layout_marginBottom="12dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    android:text="If you have rare or valuable Islamic books, translations, or scholarly material, you can share it with us to include in the app."
                    android:textSize="20sp"
                    android:layout_marginBottom="12dp"
                    android:textStyle="italic"
                    android:paddingHorizontal="5dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    android:text="3. Volunteer Support:"
                    android:textSize="20sp"
                    android:textStyle="bold|italic"
                    android:layout_marginBottom="12dp"
                    android:paddingHorizontal="5dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
                <TextView
                    android:text="Join us as a volunteer for proofreading, translating, or improving the app. Your time and skills are highly appreciated."
                    android:textSize="20sp"
                    android:layout_marginBottom="12dp"
                    android:textStyle="italic"
                    android:paddingHorizontal="5dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginVertical="10dp"
                >
                <TextView
                    android:text="Contact us at: danishajmalbutt@gmail.com \n visit our website www.####.org to get involved."
                    android:textSize="20sp"
                    android:gravity="center"
                    android:padding="10dp"
                    android:textColor="@color/off_white"
                    android:background="@drawable/page_bottom_design"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>


</FrameLayout>