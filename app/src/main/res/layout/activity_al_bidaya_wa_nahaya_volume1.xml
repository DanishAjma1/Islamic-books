<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context="com.example.books.AlBidayaWaNahayaVolume1">

    <LinearLayout
        android:id="@+id/book_dashboard_layout"
        android:layout_width="match_parent"
        android:background="@drawable/books_dashboard"
        android:layout_height="wrap_content"
        android:padding="10dp"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:id="@+id/textView2"
            android:layout_width="match_parent"
            android:textColor="#FFFDFC"
            android:gravity="center"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:text="@string/albidaya_wan_nahaya"
            android:textSize="35sp" />

        <TextView
            android:id="@+id/textView3"
            android:layout_width="match_parent"
            android:textColor="#FFFDFC"
            android:gravity="center"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:text="Volume 1"
            android:textSize="20sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:verticalScrollbarPosition="right"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/Chapters"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <!-- Chapter 1 -->
            <include layout="@layout/chapter_template"
                android:id="@+id/first_chap"
                android:tag="1|The Beginning of the Prophet’s Mission|An account of the initial revelations and the Prophet's call to Islam." />

            <!-- Chapter 2 -->
            <include layout="@layout/chapter_template"
                android:id="@+id/second_chap"
                android:tag="2|Persecution in Mecca|Details the hardships faced by early Muslims and the Prophet's steadfastness." />

            <!-- Chapter 3 -->
            <include layout="@layout/chapter_template"
                android:id="@+id/third_chap"
                android:tag="3|The Migration to Medina (Hijrah)|Chronicles the pivotal journey from Mecca to Medina, marking a new chapter in Islamic history." />

            <!-- Chapter 4 -->
            <include layout="@layout/chapter_template"
                android:id="@+id/fourth_chap"
                android:tag="4|The Battle of Badr|Describes the first major battle between Muslims and Quraysh, highlighting its significance." />

            <!-- Chapter 5 -->
            <include layout="@layout/chapter_template"
                android:id="@+id/fifth_chap"
                android:tag="5|The Battle of Uhud|Covers the events, outcomes, and lessons from this critical encounter." />

            <!-- Chapter 6 -->
            <include layout="@layout/chapter_template"
                android:id="@+id/sixth_chap"
                android:tag="6|The Treaty of Hudaybiyyah|Discusses the strategic peace treaty and its long-term implications for the Muslim community." />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
